# ── LLM Backend ────────────────────────────────────────
# "ollama" = local & private  |  "groq" = cloud & fast  |  "gemini" = cloud & vision
LLM_BACKEND=ollama

# ── Ollama (local) ─────────────────────────────────────
# Pull the model first:  ollama pull gemma4:31b
OLLAMA_MODEL=gemma4:31b
OLLAMA_URL=http://localhost:11434/api/chat

# ── Groq (cloud, free tier) ───────────────────────────
# Sign up and grab a free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (cloud, free tier) ──────────────────
# Get your free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Does your model accept images?
# "auto" = true for ollama & gemini, false for groq
VISION_LLM=auto

# ── Whisper (speech-to-text) ──────────────────────────
# tiny = fastest | base = balanced | small = most accurate
WHISPER_MODEL=tiny
ENERGY_THRESHOLD=0.015
SILENCE_MS=700
MIN_SPEECH_MS=250
SAMPLE_RATE=16000

# ── Screen / OCR ─────────────────────────────────────
OCR_ENABLED=true
MAX_OCR_CHARS=4000

# ── Text-to-Speech ───────────────────────────────────
TTS_ENABLED=true

# ── Safety Confirmations ─────────────────────────────
# Asks for voice confirmation before destructive actions
CONFIRM_DANGEROUS=true

# ── Timeout (seconds) ────────────────────────────────
REQUEST_TIMEOUT=120

# ── Conversation History (number of turns) ───────────
MAX_HISTORY=10
