# VoiceDesk configuration
# Copy to .env and edit. Every key here matches a value in
# voicedesk/config.py; run `python main.py` and preflight will tell you
# exactly what is missing.

# ---------------------------------------------------------------------
# Brain (the LLM that turns speech into actions)
# ---------------------------------------------------------------------
# ollama = fully local and private | groq = fast cloud | gemini = vision
LLM_BACKEND=ollama

# --- Ollama (local) --------------------------------------------------
# The tag must be one you have actually pulled. Check with `ollama list`.
# For vision, pull a multimodal tag (llava, qwen2.5vl) and set
# VISION_LLM=true below.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434/api/chat

# --- Groq (cloud, free tier) ----------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (cloud, free tier, vision) -----------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Does the active model accept images?
#   auto  = Gemini only (the default Groq and Ollama tags are text-only)
#   true  = force on, for llava / qwen2.5vl / other multimodal tags
#   false = force off
VISION_LLM=auto

# ---------------------------------------------------------------------
# Speech to text
# ---------------------------------------------------------------------
# local = faster-whisper on CPU, nothing leaves the machine
# groq  = Groq cloud Whisper, faster but needs GROQ_API_KEY
STT_BACKEND=local

# Local model size: tiny | base | small | medium
# tiny is fast but drops short commands; base is the better default.
WHISPER_MODEL=base

# Cloud model used when STT_BACKEND=groq
STT_MODEL=whisper-large-v3-turbo

# ---------------------------------------------------------------------
# Microphone and voice activity detection
# ---------------------------------------------------------------------
SAMPLE_RATE=16000

# RMS energy above which audio counts as speech. Lower it in a quiet room,
# raise it if a fan keeps triggering capture.
ENERGY_THRESHOLD=0.015

# Trailing silence that ends an utterance, in milliseconds.
SILENCE_MS=700

# Utterances shorter than this are discarded as noise.
MIN_SPEECH_MS=250

# ---------------------------------------------------------------------
# Screen and OCR
# ---------------------------------------------------------------------
OCR_ENABLED=true
MAX_OCR_CHARS=4000

# Leave blank to auto-discover Tesseract on PATH and in the usual install
# locations. Set it explicitly if discovery fails.
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Monitor to capture. 1 = primary display. Do not use 0: that is the
# stitched virtual desktop across all monitors, and its origin can be
# negative, which breaks coordinate math.
CAPTURE_MONITOR=1

# Long edge of the screenshot sent to the model. Full-resolution 4K PNGs
# cost seconds of upload and thousands of tokens for no accuracy gain.
MAX_SCREENSHOT_DIM=1280

# ---------------------------------------------------------------------
# Voice output
# ---------------------------------------------------------------------
TTS_ENABLED=true
TTS_RATE=175

# Substring matched against installed voice names, e.g. zira or samantha.
TTS_VOICE_HINT=

# ---------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------
# Ask out loud before destructive actions (closing windows, deleting,
# dragging, typing into a shell).
CONFIRM_DANGEROUS=true
CONFIRM_TIMEOUT=6

# Log the plan and perform no side effects. Use this when trying a new
# backend or iterating on prompts.
DRY_RUN=false

# Only these apps may be launched by open_app. Anything else is refused.
# Shells are deliberately absent: add them only if you accept that the
# model can then type commands into them.
APP_ALLOWLIST=chrome,firefox,msedge,code,notepad,calc,explorer,spotify,slack,notion

# Apps treated as destructive-tier because typing into them runs commands.
SHELL_APPS=cmd,powershell,pwsh,wt,terminal,iterm,bash,zsh

# ---------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------
REQUEST_TIMEOUT=120
MAX_RETRIES=3
RETRY_BASE_DELAY=0.75

# ---------------------------------------------------------------------
# Memory and logging
# ---------------------------------------------------------------------
# Conversation turns kept as context.
MAX_HISTORY=10

LOG_FILE=voicedesk.log
LOG_LEVEL=INFO

# Off by default: the log used to record every word you said and every
# model reply in plaintext. Turn on only while debugging.
LOG_TRANSCRIPTS=false
